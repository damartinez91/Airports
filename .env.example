# Copy to .env for local experiments. .env is gitignored.
# The live process stays off until LIVE_ASK=1.

LIVE_ASK=0
LIVE_SPEND_CAP_USD=5
LIVE_USD_PER_CALL=0.05
LIVE_RATE_PER_HOUR=10
LIVE_RATE_GLOBAL_PER_HOUR=30

# Server-side only. Do not put these in the static site or in git.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=stub

# MCP stdio server (flight-analyst-mcp). The database tools work without a key.
# ask_analyst stays disabled until ANTHROPIC_API_KEY is set. Default model is Haiku.
# FLIGHT_DB_PATH=data/flights.duckdb
# ANTHROPIC_MODEL=claude-haiku-4-5
# MCP_SPEND_CAP_USD=5
# MCP_USD_PER_CALL=0.05
